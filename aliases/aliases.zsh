#! /etc/env zsh

alias ls="eza --icons=always --group-directories-first --header "
alias lsc="ls --color=always "
alias lsl="ls -la "
# alias lsf="lsl | fzf"
alias cat="batcat "
alias q=exit

alias rmi="rm -i"
alias cpi="cp -i"
alias rmdiri="rmdir -i"
alias ..="z .."
alias z..="z .."

alias dir="tree -aC -L 2"

