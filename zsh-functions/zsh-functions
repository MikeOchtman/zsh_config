#!/usr/bin/env zsh

# include guard
[[ -z "${ZSH_FUNCTIONS_SOURCED+x}" ]] || return
ZSH_FUNCTIONS_SOURCED=1



# extract the current git branch and count the number of modified and deleted files
function gitbranch {
  local br=''
  br=$(git symbolic-ref --short HEAD 2>/dev/null)
  if [ -n "$br" ]; then
    local statstring=$(git status 2> /dev/null)
    local mod=$(print $statstring | grep modified: | wc -l)
    local del=$(print $statstring | grep deleted: | wc -l)
    br+=": m "
    br+=$mod
    br+=" d "
    br+=$del
  fi
  echo "%F{yellow}[$br]%f"
}


#returns a colorised version of $PWD
function this-directory {
  echo "%B%F{magenta}%~%f%b"
}



# useful function definitions 
# hook functions 
#
check-git-status() {
  # are we inside a git repository?
  if git rev-parse --is-inside-work-tree &> /dev/null; then
    echo -e "\n\e[1;33m--- git log last two commits --- \e[0m"
    git log -2 --oneline
    echo "\n\e[1;33mgit status\e[0m"
    git status -s
  fi
}

pwd-listing() {
  # print out a short listing of the new directory
  eza --header --long --git --classify --sort=size --color=always | head -n 10
  local dircount=$(find . -maxdepth 1 -type d | wc -l)
  local filecount=$(find . -maxdepth 1 -type f | wc -l)
  local dir_string
  if [[ $dircount == 1 ]]; then
    dir_string="there is $dircount directory"
  else
    dir_string="there are $dircount directories"
  fi
  local file_string
  if [[ $filecount == 1 ]]; then
    file_string="and $filecount file only"
  else
    file_string="and $filecount files"
  fi
  echo "$dir_string $file_string"
}


check-directory() {
  # every time we change directory, we check how it looks
  echo "\n---> \e[1;33mshort listing for $PWD... \e[0m"
  pwd-listing
  check-git-status
}

autoload -U add-zsh-hook
(( $+functions[check-directory] )) && add-zsh-hook chpwd check-directory


####################################################################################
#other functions
#

# Stolen from oh-my-zsh with some additions 
# Get the value of an alias.
#
# Arguments:
#    1. alias - The alias to get its value from
# STDOUT:
#    The value of alias $1 (if it has one).
# Return value:
#    0 if the alias was found,
#    1 if it does not exist
#
function what_alias() {
    (( $+aliases[$1] )) && echo $aliases[$1]
}


function spoof-error () {
# returns the same number as the argument
# for testing script that react to %?
  return $@
}

