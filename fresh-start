# get and set up an ssh server
sudo apt install openssh-server -y
sudo systemctl enable --now ssh
sudo ufw allow ssh
my_IP=$(ip -4 -o addr show scope global | awk '{print $4}')
echo "For SSH, this machine's IP address is " "$my_IP"
ssh_state=$(systemctl is-active ssh)
echo "The ssh server is $ssh_state"


