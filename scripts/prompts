#! /usr/bin/zsh

autoload -Uz colors && colors
# use Ctrl-Shift-u <char code> <cr> to enter unicode char
#

# load functions
source $ZDOTDIR/zsh-functions/zsh-functions

typeset -a err

# called just before each command is executed
# called just before displaying prompt
 precmd() {
  err=($pipestatus)
  RPROMPT='%F{green}$(date +%T)%f'

}


#function to look at the error code returned by previous command
#or pipe of commands and examine each element
#and extract signal names for functions that returned them, or the return code
#of the failed commands
#returns a simple  when the previous command fully succeeded
parse-error () {
  local str
# first check that the error code is all zeroes
# pull an array of unique values in $err
# check for exactly 1 element and that element == 0

  if [[ ${#${(u)err[@]}} ]] && [[ ${err[1]} -eq 0 ]]; then
    # all zero.
    str='%F{green}[]%f'
  else
  # otherwise we build a string of error codes and/or signal names
  # with '|' symbols between 
    local count=${#err[@]}
    str='%B%F{red}['
    for i in ${err[@]}; do
      if [[ $i -gt 128 ]]; then
        str+=$(kill -l $i)
      else
        str+="$i"
      fi
      if [[ count -gt 1 ]]; then
        str+="|"
      fi
      (( count-- ))
    done
    str+=']%f%b'
  fi
  print "$str"
}




promptbuilder () {
  local build="╭─"
  build+=$(parse-error)
  build+=$(gitbranch)
  build+=" %F{magenta}%n%f "
  build+=" %F{cyan}${PWD/#$HOME/~}%f \n"
  build+="╰─ $ "
  echo "${build}"

}

PROMPT='$(promptbuilder)'

