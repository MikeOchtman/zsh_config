#!/usr/bin/env zsh
# fzf features

# install zsh fzf plugin
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# set up the preview string for fzf
local f_files="([[ -f {-1} ]] && batcat --color=always --line-range 1:30 {-1})"
local f_dirs="([[ -d {-1} ]] && tree -CL 2 {-1})"
local f_other="head -n 20 {-1}"

local prev="$f_files || $f_dirs || $f_other"

export FZF_DEFAULT_OPTS="--smart-case --exact --ansi --style=full --height=40% \
--layout=reverse-list --info=inline --border=rounded --highlight-line --multi \
--tabstop=2 --preview='$prev'"

export FZF_DEFAULT_COMMAND='rg --files --hidden --follow --glob "!.git/"'
